<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aplikace pro Windows 11: WPF (kreslení meteogramu, samostatné okno, živé pozadí; kód bez XAML kvůli pixel-přesnému kreslení)
       + Win32 (složka Win32: monitory, zamčení okna, zachytávání Win+šipek, parametry příkazové řádky, umístění dat).
       Pro Linux Mint vznikne samostatná aplikace Meteo.Linux; společné je jen jádro Meteo.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Meteo</AssemblyName>
    <RootNamespace>Meteo.Windows</RootNamespace>
    <StartupObject>Meteo.Windows.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- WPF SDK tyto implicitní usingy odebírá (kvůli kolizím názvů), tak je vracíme. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meteo.Core\Meteo.Core.csproj" />
  </ItemGroup>

</Project>
